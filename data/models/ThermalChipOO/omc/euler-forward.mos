loadFile("ThermalChipOO.mo");
getErrorString();
buildModel(
    ThermalChipOO.Models.ThermalChipSimpleBoundary,
    method="euler",
    stopTime=0.4,
    numberOfIntervals=266667,
    outputFormat="csv",
    variableFilter="Tct1|Tct2|Tct3|Tct4|Tcb1|Tcb2|Tcb3|Tcb4",
    cflags="-O0",
    simflags="-lv=LOG_STATS_V -r=\"results.csv\"");
getErrorString();
