loadFile("MethanolHeatExchangersDAE.mo");
getErrorString();
buildModel(
    MethanolHeatExchangersDAE.Models.MethanolHeatExchangers,
    method="euler",
    stopTime=40,
    numberOfIntervals=40000,
    outputFormat="csv",
    variableFilter="T_m",
    cflags="-O0",
    simflags="-lv=LOG_STATS_V -r=\"results.csv\"");
getErrorString();
